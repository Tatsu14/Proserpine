rules_version = '2';
// Règles Firestore COMPLÈTES de Proserpine : règles existantes (utilisateurs) + retours des
// utilisateurs (avis et signalements). À coller dans la console Firebase (Firestore > Règles).
//
// Avant de publier : remplacer REMPLACER_PAR_L_UID_ADMIN par l'UID du compte administrateur
// (console Firebase > Authentication > Utilisateurs > colonne « UID »), puis tester dans le
// « Simulateur de règles ». Ne pas commiter l'UID réel dans le dépôt.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Existant : chaque utilisateur accède uniquement à ses propres données ---
    match /utilisateurs/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Retours des utilisateurs ---
    function estAdmin() {
      return request.auth != null && request.auth.uid == 'REMPLACER_PAR_L_UID_ADMIN';
    }

    function texteOuNul(valeur) {
      return valeur == null || valeur is string;
    }

    function infosTechniquesValides(donnees) {
      return donnees.versionApp is string && donnees.versionApp.size() <= 30
        && donnees.plateforme in ['ios', 'android', 'web']
        && texteOuNul(donnees.versionSysteme)
        && texteOuNul(donnees.modeleAppareil)
        && donnees.creeLe == request.time;
    }

    match /retours_avis/{id} {
      // Création : utilisateur connecté, champs exacts, valeurs bornées. Aucun identifiant stocké.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['fonctionnalite', 'type', 'note', 'commentaire',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.keys().hasAll(['fonctionnalite', 'type', 'note', 'commentaire',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.fonctionnalite in ['scan', 'recherche', 'guide', 'indice', 'profil', 'autre']
        && request.resource.data.type in ['idee', 'difficulte', 'design', 'eloge']
        && request.resource.data.note is int
        && request.resource.data.note >= 1 && request.resource.data.note <= 5
        && request.resource.data.commentaire is string
        && request.resource.data.commentaire.size() <= 500
        && infosTechniquesValides(request.resource.data);
      allow read: if estAdmin();
      // L'administrateur peut modifier UNIQUEMENT le statut (Nouveau / En cours / Traité).
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
        && request.resource.data.statut in ['nouveau', 'en_cours', 'traite'];
      allow delete: if false;
    }

    match /retours_signalements/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['fonctionnalite', 'gravite', 'action', 'description',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.keys().hasAll(['fonctionnalite', 'gravite', 'action', 'description',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.fonctionnalite in ['scan', 'recherche', 'guide', 'indice', 'profil', 'autre']
        && request.resource.data.gravite in ['genant', 'bloquant']
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1000
        && infosTechniquesValides(request.resource.data);
      allow read: if estAdmin();
      // L'administrateur peut modifier UNIQUEMENT le statut (Nouveau / En cours / Traité).
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
        && request.resource.data.statut in ['nouveau', 'en_cours', 'traite'];
      allow delete: if false;
    }

    // --- Base de produits de Proserpine (voir src/services/base-produits.ts) ---
    // Lecture par tout utilisateur connecté ; écriture réservée à l'administrateur.
    // PLUS TARD (système premium) : l'ajout/la modification par les abonnés, voir src/services/droits.ts,
    // par exemple : allow create, update: if request.auth != null && request.auth.token.premium == true;
    // (« premium » = custom claim Firebase posé côté serveur à l'abonnement). Le signalement de
    // consigne ci-dessous reste, lui, ouvert à tout utilisateur connecté.
    match /produits/{ean} {
      allow read: if request.auth != null;
      allow write: if estAdmin();
    }

    // EAN scannés mais introuvables, avec un compteur. L'app fait setDoc(merge) + increment(1) :
    // c'est une création au premier passage, puis une mise à jour. Les utilisateurs ne peuvent
    // QUE faire +1 (jamais lire, jamais effacer) ; aucun identifiant d'utilisateur n'est stocké.
    match /produits_introuvables/{ean} {
      allow create: if request.auth != null
        && ean.matches('^[0-9]{8,14}$')
        && request.resource.data.keys().hasOnly(['ean', 'compteur', 'dernierScan'])
        && request.resource.data.ean == ean
        && request.resource.data.compteur == 1
        && request.resource.data.dernierScan == request.time;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['compteur', 'dernierScan'])
        && request.resource.data.compteur == resource.data.compteur + 1
        && request.resource.data.dernierScan == request.time;
      allow read, delete: if estAdmin();
    }

    // Consignes de tri signalées comme fausses depuis la fiche produit. Aucun identifiant utilisateur.
    match /retours_consignes/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ean', 'nom', 'triAffiche', 'detailAffiche', 'origine',
             'triSuggere', 'commentaire', 'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.keys().hasAll(['ean', 'nom', 'triAffiche', 'detailAffiche', 'origine',
             'triSuggere', 'commentaire', 'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.ean is string
        && request.resource.data.ean.matches('^[0-9]{4,20}$')
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 120
        && request.resource.data.triAffiche is list
        && request.resource.data.triAffiche.size() >= 1 && request.resource.data.triAffiche.size() <= 6
        && request.resource.data.triAffiche.hasOnly(['pmc', 'paper', 'glass', 'organic', 'residual', 'danger'])
        && request.resource.data.detailAffiche is string && request.resource.data.detailAffiche.size() <= 300
        && request.resource.data.origine in ['lu', 'deduit', 'choisi']
        && request.resource.data.triSuggere is list
        && request.resource.data.triSuggere.size() <= 6
        && request.resource.data.triSuggere.hasOnly(['pmc', 'paper', 'glass', 'organic', 'residual', 'danger'])
        && request.resource.data.commentaire is string && request.resource.data.commentaire.size() <= 300
        && infosTechniquesValides(request.resource.data);
      allow read: if estAdmin();
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
        && request.resource.data.statut in ['nouveau', 'en_cours', 'traite'];
      allow delete: if false;
    }
  }
}
