rules_version = '2';
// Règles Firestore COMPLÈTES de Proserpine : règles existantes (utilisateurs) + retours des
// utilisateurs (avis et signalements). À coller dans la console Firebase (Firestore > Règles).
//
// Avant de publier : remplacer REMPLACER_PAR_L_UID_ADMIN par l'UID du compte administrateur
// (console Firebase > Authentication > Utilisateurs > colonne « UID »), puis tester dans le
// « Simulateur de règles ». Ne pas commiter l'UID réel dans le dépôt.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Existant : chaque utilisateur accède uniquement à ses propres données ---
    match /utilisateurs/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Retours des utilisateurs ---
    function estAdmin() {
      return request.auth != null && request.auth.uid == 'REMPLACER_PAR_L_UID_ADMIN';
    }

    function texteOuNul(valeur) {
      return valeur == null || valeur is string;
    }

    function infosTechniquesValides(donnees) {
      return donnees.versionApp is string && donnees.versionApp.size() <= 30
        && donnees.plateforme in ['ios', 'android', 'web']
        && texteOuNul(donnees.versionSysteme)
        && texteOuNul(donnees.modeleAppareil)
        && donnees.creeLe == request.time;
    }

    match /retours_avis/{id} {
      // Création : utilisateur connecté, champs exacts, valeurs bornées. Aucun identifiant stocké.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['fonctionnalite', 'type', 'note', 'commentaire',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.keys().hasAll(['fonctionnalite', 'type', 'note', 'commentaire',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.fonctionnalite in ['scan', 'recherche', 'guide', 'indice', 'profil', 'autre']
        && request.resource.data.type in ['idee', 'difficulte', 'design', 'eloge']
        && request.resource.data.note is int
        && request.resource.data.note >= 1 && request.resource.data.note <= 5
        && request.resource.data.commentaire is string
        && request.resource.data.commentaire.size() <= 500
        && infosTechniquesValides(request.resource.data);
      allow read: if estAdmin();
      // L'administrateur peut modifier UNIQUEMENT le statut (Nouveau / En cours / Traité).
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
        && request.resource.data.statut in ['nouveau', 'en_cours', 'traite'];
      allow delete: if false;
    }

    match /retours_signalements/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['fonctionnalite', 'gravite', 'action', 'description',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.keys().hasAll(['fonctionnalite', 'gravite', 'action', 'description',
             'versionApp', 'plateforme', 'versionSysteme', 'modeleAppareil', 'creeLe'])
        && request.resource.data.fonctionnalite in ['scan', 'recherche', 'guide', 'indice', 'profil', 'autre']
        && request.resource.data.gravite in ['genant', 'bloquant']
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1000
        && infosTechniquesValides(request.resource.data);
      allow read: if estAdmin();
      // L'administrateur peut modifier UNIQUEMENT le statut (Nouveau / En cours / Traité).
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
        && request.resource.data.statut in ['nouveau', 'en_cours', 'traite'];
      allow delete: if false;
    }
  }
}
